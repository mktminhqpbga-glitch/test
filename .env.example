# Set these securely in the process environment; npm start does not load .env automatically.
# Local mode: Chrome and this Node process run on the same machine.
HOST=127.0.0.1
PORT=4174
# Required before HOST=0.0.0.0. Enter the same access code in the web Settings for this session.
MOOZ_ACCESS_TOKEN=
# Optional API credentials. Never put values into frontend files or exported projects.
MOOZ_OPENAI_KEY=
MOOZ_GOOGLE_KEY=
# Optional: needed when Chrome is on another machine, including cloud hosting.
MOOZ_RELAY_URL=
MOOZ_RELAY_KEY=
# Optional model overrides, selected according to the account's API permissions.
MOOZ_OPENAI_TEXT_MODEL=gpt-4.1-mini
MOOZ_OPENAI_IMAGE_MODEL=gpt-image-1
MOOZ_GOOGLE_TEXT_MODEL=gemini-2.5-flash
MOOZ_GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
